  m_text: "\uAD6D\uB0B4 \uCEF5\uC774 \uB05D\uB098\uBA74 \uC5F4\uB9AC\uB294 \uB300\uB959
    \uB300\uD68C\uC785\uB2C8\uB2E4. \uB098\uB77C\uBCC4 \uAD6D\uB0B4 \uCEF5 \uC6B0\uC2B9
    6\uD300\uC774 \uD50C\uB808\uC774\uC624\uD504(3\uD300\uC529 2\uAC1C \uC870)\uB97C
    \uCE58\uB7EC 4\uD300\uC774 \uC624\uB974\uACE0, \uB098\uB77C\uBCC4 1\uBD80 1\xB72\uC704
