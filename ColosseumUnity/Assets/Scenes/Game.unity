      m_Calls: []
  m_text: "\uC815\uADDC \uB9AC\uADF8\uAC00 \uB05D\uB098\uBA74 \uB098\uB77C\uC758
    1~4\uBD80 40\uAC1C \uB8E8\uB450\uC2A4\uAC00 \uBAA8\uB450 \uB098\uC635\uB2C8\uB2E4.
    40\uAC15\xB720\uAC15\xB710\uAC15\uC740 5:5 \uBBF8\uC2DC\uC624 \uB2E8\uD310, 5\uAC15\uC740
    \uD55C \uBC88\uC529 \uB9DE\uBD99\uC5B4 \uC2B9\uC218\uB85C \uC6B0\uC2B9\uC744
    \uAC00\uB9BD\uB2C8\uB2E4(\uAC19\uC73C\uBA74 \uC4F0\uB7EC\uB728\uB9B0 \uC0C1\uB300
    \uC218, \uADF8\uB2E4\uC74C \uC2B9\uC790\uC2B9). \uC6B0\uC2B9\uD558\uBA74 \uBA87
    \uBD80\uB4E0 \uD310\uD14C\uC628 \uCEF5 \uD50C\uB808\uC774\uC624\uD504\uC5D0 \uB098\uAC11\uB2C8\uB2E4.
    RP\uB294 \uC624\uAC00\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
